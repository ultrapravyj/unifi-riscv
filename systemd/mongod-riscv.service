[Unit]
Description=Native MongoDB for experimental UniFi riscv64 installer
After=network.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=unifi-mongo
Group=unifi-mongo
ExecStart=/opt/unifi-riscv/mongodb/bin/mongod --config /etc/unifi-riscv/mongod.conf
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
LimitNOFILE=64000
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
