[Unit]
Description=Experimental UniFi Network Server on native riscv64
Wants=mongod-riscv.service
After=network-online.target mongod-riscv.service
Wants=network-online.target
PartOf=mongod-riscv.service
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=unifi
Group=unifi
WorkingDirectory=/opt/unifi-riscv/app/current
RuntimeDirectory=unifi
RuntimeDirectoryMode=0750
ExecStartPre=+/usr/bin/python3 /opt/unifi-riscv/scripts/manage.py database-ready
ExecStart=/opt/unifi-riscv/scripts/run-unifi.sh
Restart=always
RestartSec=15
TimeoutStartSec=600
TimeoutStopSec=120
SuccessExitStatus=143
LimitNOFILE=64000
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
